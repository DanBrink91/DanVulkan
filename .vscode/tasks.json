{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "windows"],
      "osx": {
        "args": ["--preset", "macos"]
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "osx": {
        "args": ["--build", "--preset", "macos-debug"],
        "problemMatcher": {
          "owner": "cpp",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|fatal error|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      },
      "dependsOn": "CMake: configure",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*(.*?)\\((\\d+)(?:,(\\d+))?\\):\\s+(fatal error|error|warning)\\s+[A-Za-z]+\\d+:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "DanVulkan: build and run",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\windows\\Debug\\DanVulkan.exe",
      "osx": {
        "command": "${workspaceFolder}/build/macos/DanVulkan"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: build (Debug)",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "DanVulkan: validation tests",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "osx": {
        "args": ["--preset", "macos-debug"]
      },
      "dependsOn": "CMake: build (Debug)",
      "problemMatcher": []
    }
  ]
}
