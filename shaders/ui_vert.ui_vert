#version 460

layout(push_constant) uniform UiPushConstants
{
    vec2 viewportSize;
} ui;

layout(location = 0) in vec2 inPosition;
layout(location = 1) in vec2 inGlyphUv;
layout(location = 2) in vec4 inColor;
layout(location = 3) in uvec2 inGlyphMask;

layout(location = 0) out vec2 outGlyphUv;
layout(location = 1) out vec4 outColor;
layout(location = 2) flat out uvec2 outGlyphMask;

void main()
{
    vec2 normalized = inPosition / ui.viewportSize;
    gl_Position = vec4(normalized.x * 2.0 - 1.0, normalized.y * 2.0 - 1.0, 0.0, 1.0);
    outGlyphUv = inGlyphUv;
    outColor = inColor;
    outGlyphMask = inGlyphMask;
}
